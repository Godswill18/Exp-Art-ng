# Browser-safe values only. Anything prefixed VITE_ is shipped to every visitor.
# Never put secrets (reCAPTCHA SECRET key, email passwords, DB creds, signing keys) here.

# REST API base URL (no trailing slash)
VITE_API_URL=https://api.experiencenigeriaart.com
# Optional: where uploaded images are served from (defaults to VITE_API_URL)
# VITE_IMAGE_URL=https://api.experiencenigeriaart.com

# Google reCAPTCHA v2 SITE key (public). The secret key lives on the backend only.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# Set to "true" only once the backend verifies the reCAPTCHA token on /api/contacts/create-contact
# VITE_SEND_CAPTCHA_TOKEN=false

# EmailJS (public identifiers; used only as a best-effort notification after the API saved the message)
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
